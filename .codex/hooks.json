{
  "description": "Use remote Graphify for code exploration in sirus-harness.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/graphify-remote-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|shell|shell_command|Read|Grep|Glob)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/graphify-remote-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

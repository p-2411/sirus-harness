nt-before-prompt design."}, {"id": "docs_superpowers_specs_2026_09_07_simplify_audits_session_queue_policy", "label": "Historical queued-command policy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIFO prompt draining must work without a mounted Chat, but a queued slash command pauses itself and everything behind it; queues were not persisted."}], "edges": [{"source": "docs_superpowers_specs_2026_09_07_simplify_audits_session_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_session_god_class", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/session.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_session_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_session_round_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/session.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_session_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_session_checkpoint_barrier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/session.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_session_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_session_queue_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/session.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_sp
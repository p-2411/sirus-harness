{"nodes": [{"id": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_audit", "label": "Provider/model integration audit (2026-09-07)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_modelstrategy", "label": "Historical Provider / ModelStrategy coupling", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One vendor object combined model dispatch, credentials, auth UI and fallback; model identity was lost and model facts duplicated across four edit sites."}, {"id": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_fallback", "label": "Historical credential fallback invariants", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserve per-runtime stickiness, no fallback after abort, no replay of delegated tools with unknown outcomes, completed tool-work carryover and masked exhaustion errors."}, {"id": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_active_source", "label": "Historical global active-source defect", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single currentSource slot could display whichever agent most recently started a turn despite concurrent runtimes; the audit calls for per-runtime tracking while keeping live sidebar updates."}, {"id": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_runtime_switch", "label": "Historical cross-vendor runtime leak", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "resetRuntime resolved via the current model's vendor while model changes did not reset, orphaning a Claude child after switching to GPT until a global reset."}], "edges": [{"source": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_modelstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_active_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_audit", "target": "docs_superpowers_specs_2026_09_07_simplify_audits_providers_runtime_switch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-07-simplify-audits/providers.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_07_simplify_audits
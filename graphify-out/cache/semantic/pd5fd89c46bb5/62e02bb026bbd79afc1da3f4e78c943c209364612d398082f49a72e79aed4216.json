{"nodes": [{"id": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_spec", "label": "Jev session routing: historical approved design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_jev", "label": "Removed Jev session-model routing", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical design selected a new session's model through TypeSafe AI System One. The document explicitly states Jev routing has since been removed and sessions use the saved preference or default."}, {"id": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_candidates", "label": "Historical latest-model routing candidates", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One latest model per credentialed vendor with allowance; API keys and unknown cached usage count as available, one candidate bypasses Jev, and no candidates preserve fallback."}, {"id": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_fallback", "label": "Historical bounded confidence fallback", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit user choice wins; missing JEV_API, a two-second timeout without retry, errors or confidence below 0.5 retain the starting model silently."}, {"id": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_profile", "label": "Historical ModelProfile routing criteria", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profiles combine researched strengths, named/date-specific benchmarks, practical reviews and token prices; live allowance is rendered alongside each candidate instead of stored in catalog facts."}], "edges": [{"source": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_spec", "target": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_jev", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_spec", "target": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_candidates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_spec", "target": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_spec", "target": "docs_superpowers_specs_2026_09_21_jev_session_routing_design_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-21-jev-session-routing-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_21_j
{"nodes": [{"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_spec", "label": "Multi-vendor cockpit migration: draft for approval", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_acp_migration", "label": "Proposed ACP-only vendor runtime migration", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft replaces direct API transports and Sirus's agent loop with Claude/Codex native harnesses over ACP; launch specs isolate vendor differences and exact adapter pins limit protocol drift."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_addressed_transcripts", "label": "Proposed addressed participant transcripts", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only directed messages enter each participant's record; whole attributed sender messages avoid losing assumed context, and the merged timeline is a derived UI/snapshot view."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_mcp", "label": "Proposed loopback HTTP MCP bridge", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One server exposes Sirus memory/delegation with session token and participant identity; MCP-over-ACP was unstable and unsupported by both verified adapters."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_vendor_permissions", "label": "Proposed vendor-owned permission review", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mode kinds replace Sirus's classifier/judge and render vendor escalation options. The draft notes differing Claude/Codex sandbox and auto-mode behavior, requiring surfaced fallback status."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_checkpoint_before_prompt", "label": "Proposed pre-prompt checkpoint", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native tools cannot wait on host barriers, so capture must finish before prompting; session-wide sequence numbers support rewind across independent transcripts."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_native_compaction", "label": "Proposed vendor-native compaction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Advertising session.compaction exposes vendor compaction boundaries, and /compact passes through as a prompt; shared-transcript compaction is removed."}, {"id": "docs_superpowers_specs_2026_09_20_multi_vendor_cockpit_questions_deferred", "label": "Draft defers elicitation support", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-20-multi-vendor-cockpit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This draft does not advertise elicitation.form or allow AskUserQuestion, although it identifies ACP form support; current architecture in this chunk documents t
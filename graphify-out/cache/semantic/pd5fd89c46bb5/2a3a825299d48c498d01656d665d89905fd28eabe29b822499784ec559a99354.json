{"nodes": [{"id": "docs_architecture_architecture", "label": "Sirus architecture", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_session", "label": "Session facade", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Described implementation: owns one conversation and delegates transcripts, routing, rounds, checkpoints, queue and notifications to independently constructible collaborators."}, {"id": "docs_architecture_transcript", "label": "Per-participant Transcript", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only addressed entries and the participant's own responses enter its record; one delivered entry object can be shared by several transcripts."}, {"id": "docs_architecture_timeline", "label": "Timeline", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocates session-wide sequence numbers and merges participant transcripts into an ordered UI and snapshot view; owns assistant-entry identity."}, {"id": "docs_architecture_participantroster", "label": "ParticipantRoster", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns participants and the single @name mention grammar."}, {"id": "docs_architecture_turnrunner", "label": "TurnRunner", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs addressed participants in parallel and delivers whole attributed messages to mentioned peers in subsequent rounds; owns participant-introduction text."}, {"id": "docs_architecture_checkpointlog", "label": "CheckpointLog and DirectoryActivity", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pre-turn checkpoint is awaited before prompting because native vendor tools cannot wait on Sirus's mutation barrier. Chat rewinds truncate all transcripts by sequence and rebuild runtimes; worktree workers do not block project-file rewind."}, {"id": "docs_architecture_messagequeue", "label": "MessageQueue", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One isAutoSendable predicate governs automatic draining; completed worker reports are delivered before queued user prompts."}, {"id": "docs_architecture_changefeed", "label": "ChangeFeed", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns listeners, version counters and the 50 ms streaming throttle."}, {"id": "docs_architecture_sessionagent", "label": "SessionAgent and RuntimeHost", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent owns its transcript, model, credential and runtime; RuntimeHost supplies session-owned prompt, permissions, MCP identity and escalation handling."}, {"id": "docs_architecture_runtime", "label": "ACP Runtime", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ACP session plus its process and forked sessions; warm and natively resumed runtimes receive only the new turn, while fresh ones receive a transcript recap."}, {"id": "docs_architecture_acp", "label": "Agent Client Protocol", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_launch", "label": "Vendor launch specifications", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "launch.ts contains the per-vendor command, credential environment and shared Launch.session configuration for new, forked and resumed sessions."}, {"id": "docs_architecture_providers", "label": "Credential providers", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers own credential priority, profile isolation, sign-in and allowance, but no wire protocol or turn loop. An API-key Codex credential has a separate home to avoid inherited ChatGPT authentication."}, {"id": "docs_architecture_catalog", "label": "Model and vendor catalog", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MODELS and VENDOR_INFO centralize facts; a new model is one row, while vendor integration also requires launch, registry, login, usage and persistence enum updates."}, {"id": "docs_architecture_routing", "label": "Default session and worker routing", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture text describes router.ts choosing an initial session model and a worker's model and depth when unspecified. Historical Jev design documents elsewhere in this chunk explicitly say Jev routing was removed."}, {"id": "docs_architecture_mcp_server", "label": "Sirus loopback MCP server", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ephemeral loopback HTTP server serves all runtimes; per-session bearer tokens and caller names bind requests to their owner. Tools are listed per request so memory toggles apply immediately."}, {"id": "docs_architecture_delegation_tools", "label": "Sirus delegation tools", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SpawnAgent, CheckAgent, MessageAgent, CancelAgent and ListAgents expose Sirus workers. Audience filtering hides delegation tools from workers."}, {"id": "docs_architecture_workers", "label": "Session-owned background workers", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Completion queues an owner-directed report and wakes the owner when no turn, rewind, compaction or restore holds the session. Foreground waits become background work on owner cancellation or the tool wait limit."}, {"id": "docs_architecture_workerrecord", "label": "WorkerRecord persistence", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots preserve runs; a working run reopens as interrupted with no live agent, its report enters the owner's next prompt, and nothing restarts automatically. Later messaging can reopen the worker's native session."}, {"id": "docs_architecture_worktree", "label": "Worker worktree isolation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git workers run from project HEAD on sirus/<id> branches under the data directory. Removing the session removes worktrees but preserves branches; non-repositories run workers in place."}, {"id": "docs_architecture_forked_worker_handover", "label": "FORKED_WORKER_HANDOVER", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both vendors retain the owner's system prompt on fork, so the worker contract is supplied in its first prompt; failed forks fall back to text seeding from the owner record."}, {"id": "docs_architecture_permissions", "label": "Vendor permission modes", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ask, auto and bypass map to standard, auto_review and full_access. Sirus queues vendor escalations and returns vendor-provided options; it keeps no allowance or judge of its own."}, {"id": "docs_architecture_questions", "label": "ACP form elicitation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor user questions become per-session forms queued behind approvals; adapter-marked free text becomes Other. Worker questions are declined immediately, and approval/question waits do not count as watchdog silence."}, {"id": "docs_architecture_skills", "label": "Vendor-native skills and skillPrompt", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude receives user/project skill plugins plus enabled installed plugins; Codex discovers its own skill folders. Sirus rewrites /name into vendor syntax, keeps recap context in a separate block and sends images before command text."}, {"id": "docs_architecture_native_recovery", "label": "Native session recovery", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved vendor ID, original directory, credential source, profile home and prompt hash permit resume after restart or process loss. Same-home credentials can reuse history; missing or incompatible state falls back to a bounded recap with a notice."}, {"id": "docs_architecture_compaction", "label": "Runtime-owned compaction", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each runtime compacts itself and reports a boundary; Session.compact sends /compact to the default participant. Sirus has no automatic compaction loop."}, {"id": "docs_architecture_quietfor", "label": "quietFor watchdog", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures runtime silence excluding user-approval waits and running tools; status appears after one minute and unattended workers stop after 15 minutes."}, {"id": "docs_architecture_persistence", "label": "Snapshot-only persistence and typed settings", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistence reads/writes plain snapshots and normalizes older files without depending on runtime code. openSettings preserves unknown keys; Session.fromSnapshot rebuilds the domain object."}, {"id": "docs_architecture_memory", "label": "Persistent SQLite vector memory", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_commands", "label": "CommandSpec and CommandSession", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands receive a structural Session subset and opt-in image/quit capabilities; registry order determines menus."}, {"id": "docs_architecture_workerstrip", "label": "WorkerStrip and SpawnAgent transcript row", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The strip reads the mutable run index directly, shows the freshest active/recent run and freezes ordering during keyboard focus. The original SpawnAgent row displays the completed report as expanded Markdown."}], "edges": [{"source": "docs_architecture_architecture", "target": "docs_architecture_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1}, {"source": "docs_architecture_architecture", "target": "docs_architecture_transcript", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1}, {"source": "docs_architecture_architecture", "target": "docs_architecture_timeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1}, {"sou
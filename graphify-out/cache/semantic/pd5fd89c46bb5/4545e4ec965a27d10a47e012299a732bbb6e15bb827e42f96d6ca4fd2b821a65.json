{"nodes": [{"id": "docs_superpowers_specs_2026_09_21_workers_design_spec", "label": "Workers: historical approved design (2026-09-21)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_background_reports", "label": "Proposed worker completion wakes owner", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The historical worker design delivers terminal reports into the owner's transcript and starts its next turn; reports wait while busy and precede user-queued prompts. Escape cancels only the foreground turn."}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_isolation", "label": "Proposed worker worktree isolation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workers branch from project HEAD without uncommitted changes or ignored directories, preserving branches after session cleanup and allowing project-file rewind while isolated workers run."}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_fork_steer", "label": "Proposed owner-context fork and steering", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ACP fork shares the owner's process but uses worker callbacks and MCP identity; the first prompt carries the worker contract. Mid-run messages use _session/steering; this historical version refuses messages to finished workers."}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_record", "label": "Proposed persisted WorkerRecord", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots hold transcript, branch, status and report; restored working runs become interrupted records, do not restart and report on the owner's next prompt."}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_jev", "label": "Removed Jev worker-model routing", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical proposal chose model and thinking level from allowance-qualified candidates except Haiku, with owner model/level fallback. The document explicitly says Jev routing was removed and current selection rules now apply."}, {"id": "docs_superpowers_specs_2026_09_21_workers_design_strip", "label": "Proposed multi-line worker strip", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical spec proposes one line per worker with running first and finished lines dimmed until dismissal; current architecture instead describes one freshest-run line with a counter."}], "edges": [{"source": "docs_superpowers_specs_2026_09_21_workers_design_spec", "target": "docs_superpowers_specs_2026_09_21_workers_design_background_reports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/superpowers/specs/2026-09-21-workers-design.md", "source_location": null, "weight": 1}, {"source": "docs_superpowers_specs_2026_09_21_workers_design_spec", "target": "docs_superpowers_specs_2026_09_21_workers_design_isolation
{
  "name": "sirus-harness",
  "version": "1.1.0",
  "description": "A local-first terminal client for running AI coding agents.",
  "license": "MIT",
  "author": "Sirus contributors",
  "homepage": "https://github.com/p-2411/sirus-harness#readme",
  "bugs": {
    "url": "https://github.com/p-2411/sirus-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-2411/sirus-harness.git"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "bin": {
    "sirus": "bin/sirus.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.12"
  },
  "packageManager": "bun@1.3.12",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "onnxruntime-node": "1.29.0",
    "adm-zip": "^0.6.0"
  },
  "scripts": {
    "i": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release:check": "bun test && bun run typecheck && npm pack --dry-run",
    "prepublishOnly": "bun test && bun run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "bun-types": "^1.3.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.257",
    "@anthropic-ai/sdk": "^0.122.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29",
    "@openai/codex": "0.153.3",
    "bun": "^1.4.0",
    "ink": "^7.1.1",
    "marked": "^18.0.11",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "sqlite-vec": "^0.1.9",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "zod": "^4"
  }
}
